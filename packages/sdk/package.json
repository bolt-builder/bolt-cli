{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.20.7",
  "name": "@bolt-ai/sdk-v2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "tsc -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@bolt-ai/client": "workspace:*",
    "@bolt-ai/core": "workspace:*",
    "@bolt-ai/plugin": "workspace:*",
    "@bolt-ai/schema": "workspace:*",
    "@bolt-ai/server": "workspace:*",
    "@bolt-ai/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@bolt-ai/ai": "workspace:*",
    "@bolt-ai/httpapi-codegen": "workspace:*",
    "@bolt-ai/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}

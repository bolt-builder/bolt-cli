#!/usr/bin/env bash
set -euo pipefail

# Publishes the extension to the Visual Studio Marketplace (and optionally
# Open VSX) for the Bolt publisher. Requires:
#   VSCE_PAT        Marketplace personal access token (read by vsce)
#   OPENVSX_TOKEN   optional; when set, also publishes to Open VSX

latest_tag=$(git tag --sort=committerdate | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)
if [ -z "$latest_tag" ]; then
    echo "No vscode-v* tags found"
    exit 1
fi
echo "Latest tag: $latest_tag"
version=$(echo "$latest_tag" | sed 's/^vscode-v//')
echo "Publishing version: $version"

vsce package --no-git-tag-version --no-update-package-json --no-dependencies -o dist/bolt.vsix "$version"

vsce publish --packagePath dist/bolt.vsix

if [ -n "${OPENVSX_TOKEN:-}" ]; then
    npx ovsx publish dist/bolt.vsix -p "$OPENVSX_TOKEN"
fi
